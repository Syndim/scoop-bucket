{
    "version": "4.1.5",
    "description": "Flutter Version Management: A simple CLI to manage Flutter SDK versions.",
    "homepage": "https://github.com/leoafarias/fvm",
    "license": "",
    "architecture": {
        "64bit": {
            "url": "https://gh.llkk.cc/https://github.com/leoafarias/fvm/releases/download/4.1.5/fvm-4.1.5-windows-x64.zip",
            "hash": "69d581dad58d86c909860fb8fc3ccbfe4db288df1b1dabbe865ae87a1521ac99"
        }
    },
    "bin": "fvm/fvm.bat",
    "checkver": {
        "github": "https://github.com/leoafarias/fvm",
